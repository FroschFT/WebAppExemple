# Local development defaults. Copy this file to .env and keep .env uncommitted.
ENVIRONMENT=development
DEBUG=true

# Development can use the built-in fallback when this is empty.
# Production requires a unique value, for example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

DATABASE_URI=sqlite:///app.db
SWAGGER_URLS={"FROSCH_KANJI_BACK":"http://127.0.0.1:8084/swagger"}
